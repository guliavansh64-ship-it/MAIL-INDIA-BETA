PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Public Firebase web API key (not the Admin service account credential)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Absolute path to a private Firebase service account JSON on the server only
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Comma-separated frontend origins, for example https://app.example.com
CORS_ORIGINS=http://localhost:3000
# ZetPay UPI Payment Integration
ZETPAY_API_KEY=ZPPCCkPtfAH7EC78UMNT8kUqm7q5XdjNRSX
ZETPAY_BASE_URL=https://zetpay-beta.vercel.app
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Experimental SMTP sending. Do not enable for production.
ENABLE_EXPERIMENTAL_SENDING=false
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 32. Never change without migrating credentials.
SENDER_ENCRYPTION_KEY=
